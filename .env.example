# ====================================================================
#  LongMemory 配置模板
#  复制到 .env 后填入真实值即可。本文件提交到 git(只有示例 key,无敏感信息)。
#  真实 key 写到 .env(被 .gitignore 排除,不入版本控制)。
#
#  当前配置示例:LLM 用 MiniMax,Embedding 用阿里云百炼
#  (LLM 和 Embedding 可以走不同 provider,只要 OpenAI 兼容即可)
# ====================================================================


# ── Required ────────────────────────────────────────────────────────
# 必填:OpenAI 兼容 API key。LLM 和 Embedding 都用同一个 key,
# 或分别用 LLM/LLM_BASE_URL 和 OPENAI/OPENAI_BASE_URL。
LONGMEMORY_OPENAI_API_KEY=sk-your-key-here


# ── LLM provider (chat) ─────────────────────────────────────────────
# LLM 调用的 API base URL。改这个就能换 MiniMax / Anthropic / Ollama / vLLM。
LONGMEMORY_OPENAI_BASE_URL=https://api.openai.com/v1

# chat 模型,用于 fact 抽取 / dedup / query 改写 / rerank。
LONGMEMORY_MODEL=gpt-4.1-mini


# ── Embedding ───────────────────────────────────────────────────────
# Embedding 模型。
LONGMEMORY_EMBEDDING_MODEL=text-embedding-3-small

# 必须跟 Embedding 模型输出维度一致,常见:
#   text-embedding-3-small : 1536
#   text-embedding-3-large : 3072
#   text-embedding-ada-002 : 1536
#   nomic-embed-text(本地): 768
#   mxbai-embed-large(本地): 1024
LONGMEMORY_EMBEDDING_DIM=1536


# ── Storage ────────────────────────────────────────────────────────
# SQLite 数据库文件路径。相对路径相对当前工作目录。
# 记住在 .gitignore 里排除了 *.db,所以不会被 git 追踪。
LONGMEMORY_DB_PATH=./longmemory.db


# ── MCP server ─────────────────────────────────────────────────────
# MCP HTTP server 监听的端口。
LONGMEMORY_MCP_PORT=7331

# 监听地址。
#   127.0.0.1  仅本机(默认,安全)
#   0.0.0.0    所有网卡(LAN / Docker)
LONGMEMORY_MCP_HOST=127.0.0.1


# ── Engine behavior ────────────────────────────────────────────────
# 召回门槛:score 低于这个值的记忆被丢弃(不返回)。
# 推荐 0.7 — LLM rerank 的 0.5~0.7 区间是边缘相关,只有 ≥0.7 才稳。
#   0.3  宽松(漏多)
#   0.5  中等
#   0.7  推荐(硬过滤)
#   0.9  极严
LONGMEMORY_MIN_SCORE=0.7

# LLM 重排候选数:把 top-N 给 LLM 端到端重排。
#   0   不重排(纯 4 信号融合)
#   30  轻量
#   100 默认(平衡)
LONGMEMORY_RERANK_DEPTH=30

# Query 改写变体数上限。
# 推荐 1 — LLM 改写会让 query 变宽,引入边缘相关项。
#   1  不改写(推荐,只走 abbreviation expansion)
#   4  默认
LONGMEMORY_MAX_QUERY_VARIANTS=1


# ── Optional:默认 scope(调用方不指定时自动应用) ─────────────────
# 适合单用户本地使用,避免每次都传 user_id。
# LONGMEMORY_DEFAULT_SCOPE_USER_ID=alice
# LONGMEMORY_DEFAULT_SCOPE_AGENT_ID=main


# ====================================================================
#  预设示例(选一组,注释掉其他)
# ====================================================================

# ── 预设 1:OpenAI(默认,只需填 key) ───────────────────────────
# LONGMEMORY_OPENAI_API_KEY=sk-proj-xxxxx
# LONGMEMORY_OPENAI_BASE_URL=https://api.openai.com/v1
# LONGMEMORY_MODEL=gpt-4.1-mini
# LONGMEMORY_EMBEDDING_MODEL=text-embedding-3-small
# LONGMEMORY_EMBEDDING_DIM=1536

# ── 预设 2:MiniMax ───────────────────────────────────────
# LONGMEMORY_OPENAI_API_KEY=sk-cp-your-key
# LONGMEMORY_OPENAI_BASE_URL=https://api.minimaxi.com/v1
# LONGMEMORY_MODEL=MiniMax-M3
# LONGMEMORY_EMBEDDING_MODEL=text-embedding-3-small
# LONGMEMORY_EMBEDDING_DIM=1536

# ── 预设 3:阿里云百炼(LLM + Embedding 走 OpenAI 兼容模式) ───────
# LONGMEMORY_OPENAI_API_KEY=sk-ws-your-dashscope-key
# LONGMEMORY_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LONGMEMORY_MODEL=qwen-plus
# LONGMEMORY_EMBEDDING_MODEL=text-embedding-v3
# LONGMEMORY_EMBEDDING_DIM=1024

# ── 预设 4:Ollama(本地免费) ────────────────────────────
# 需要先运行 ollama serve 并 ollama pull 模型
# LONGMEMORY_OPENAI_API_KEY=ollama
# LONGMEMORY_OPENAI_BASE_URL=http://localhost:11434/v1
# LONGMEMORY_MODEL=llama3.2
# LONGMEMORY_EMBEDDING_MODEL=nomic-embed-text
# LONGMEMORY_EMBEDDING_DIM=768