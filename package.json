{
    "name": "longmemory",
    "version": "1.0.0",
    "description": "LongMemory Hydrograph: durable, temporal, governed project-level memory for Node.js agents.",
    "license": "Apache-2.0",
    "keywords": [
        "ai",
        "agents",
        "memory",
        "mcp",
        "sqlite",
        "temporal"
    ],
    "engines": {
        "node": ">=20"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./mcp": {
            "import": "./dist/mcp/index.js",
            "types": "./dist/mcp/index.d.ts"
        },
        "./connectors": {
            "import": "./dist/connectors/index.js",
            "types": "./dist/connectors/index.d.ts"
        },
        "./project": {
            "import": "./dist/core/project/index.js",
            "types": "./dist/core/project/index.d.ts"
        }
    },
    "bin": {
        "longmemory": "dist/cli/index.js"
    },
    "files": [
        "dist",
        "README.md",
        "docs",
        "LICENSE"
    ],
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/stores/sqlite',{recursive:true});fs.copyFileSync('src/stores/sqlite/schema.sql','dist/stores/sqlite/schema.sql')\"",
        "start": "node dist/server/index.js",
        "dev": "node --import tsx src/cli/index.ts status",
        "serve": "tsx src/server/index.ts",
        "mcp:stdio": "tsx src/cli/index.ts mcp",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.19.25",
        "@types/turndown": "^5.0.6",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "yaml": "^2.8.1"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.1093.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "better-sqlite3": "^12.11.1",
        "mammoth": "^1.12.0",
        "pdf-parse": "^2.4.5",
        "turndown": "^7.2.4",
        "zod": "^4.4.3"
    }
}
