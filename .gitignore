#
#  file  : .gitignore
#  usage : supports LongMemory .gitignore

node_modules/
dist/
.env
*.log
tmp
*.env

# ── LongMemory auto-created SQLite DBs (mem0-style, single file) ──
# Default location
/longmemory.db
/longmemory.db-shm
/longmemory.db-wal
# Honoring LONGMEMORY_DB_PATH (any path the engine auto-creates)
*.db
*.db-shm
*.db-wal

# Reserved engine workspace state
.longmemory/